@page "/chat"
@using BlazorChatbot.Models
@inject BlazorChatbot.Services.IOpenAIChatService ChatService
@inject BlazorChatbot.Services.IPersonaService PersonaService
@inject BlazorChatbot.Services.IPhilosophicalRelevanceService RelevanceService

<h3>Chat with AI</h3>
<p><strong>Current Persona:</strong> @currentPersonaName</p>

<div class="chat-box">
    @foreach (var msg in messages)
    {
        <div class="chat-message @(msg.Role == "User" ? "user" : "ai")">
            @if (msg.Role == "AI" && !string.IsNullOrWhiteSpace(msg.PersonaImagePath))
            {
                <div class="persona-container">
                    <img src="@msg.PersonaImagePath" alt="Persona" class="persona-image" />
                    <div class="persona-name">@msg.PersonaName</div>
                </div>
            }

            <strong>@msg.Role:</strong> @msg.Content
        </div>
    }
</div>

<div class="input-row">
    <input @bind="userMessage" @bind:event="oninput" placeholder="Say something..." />
    <button @onclick="SendMessage">Send</button>
</div>

<select @onchange="SetPersona">
    @foreach (var p in personas)
    {
        <option value="@p.SystemPrompt" selected="@(p.SystemPrompt == currentPrompt)">
            @p.Name
        </option>
    }
</select>

@code {
    private string userMessage = string.Empty;
    private List<ChatMessage> messages = new();
    private IReadOnlyList<Persona> personas = Array.Empty<Persona>();

    private string currentPersonaName = "Philosophy Professor (Balanced)";
    private string currentPrompt = string.Empty;

    protected override void OnInitialized()
    {
        personas = PersonaService.GetPersonas();

        var defaultPersona = PersonaService.GetDefaultPersona();

        if (defaultPersona is not null)
        {
            currentPrompt = defaultPersona.SystemPrompt;
            currentPersonaName = defaultPersona.Name;
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userMessage))
            return;

        var submittedMessage = userMessage.Trim();

        messages.Add(new ChatMessage("User", submittedMessage));

        var assessment = RelevanceService.Assess(submittedMessage);

        if (assessment.Classification != PhilosophicalRelevance.Relevant)
        {
            var localReply = assessment.Classification switch
            {
                PhilosophicalRelevance.Transformable
                    => assessment.SuggestedReframing
                        ?? "That could become a philosophical question, but it needs to be reframed.",

                PhilosophicalRelevance.Uncertain
                    => "I’m not yet sure what philosophical question you have in mind. Could you clarify the philosophical issue?",

                _ => "That does not appear to be a philosophical question."
            };

            messages.Add(new ChatMessage(
                "AI",
                localReply,
                personaName: "Philosobot"));

            userMessage = string.Empty;
            return;
        }

        var payload = new[]
        {
            new ChatMessage("System", currentPrompt),
            new ChatMessage("User", submittedMessage)
        };

        var persona = PersonaService.GetPersonaByPrompt(currentPrompt);

        try
        {
            var reply = await ChatService.SendMessageAsync(payload);

            messages.Add(new ChatMessage(
                "AI",
                reply,
                persona?.ImagePath,
                persona?.Name));
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"OpenAI request error: {ex.Message}");

            messages.Add(new ChatMessage(
                "AI",
                "The philosophical oracle is temporarily unavailable. Please try again later.",
                persona?.ImagePath,
                persona?.Name ?? "Philosobot"));
        }
        finally
        {
            userMessage = string.Empty;
        }
    }

    private void SetPersona(ChangeEventArgs e)
    {
        var selectedPrompt = e.Value?.ToString();
        currentPrompt = selectedPrompt ?? string.Empty;

        var selected = PersonaService.GetPersonaByPrompt(selectedPrompt);
        currentPersonaName = selected?.Name ?? "Unknown Persona";
    }
}