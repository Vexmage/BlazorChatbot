@page "/personas"
@using BlazorChatbot.Models
@inject BlazorChatbot.Services.IPersonaService PersonaService

<h3>Philosobot Personas</h3>

<div class="persona-grid">
    @foreach (var persona in personas)
    {
        <div class="persona-card">
            <img src="@persona.ImagePath" alt="@persona.DisplayName" class="persona-image" />
            <h4>@persona.DisplayName</h4>
            <p class="bio">@persona.Bio</p>

            <details>
                <summary>System Prompt</summary>
                <pre>@persona.SystemPrompt</pre>
            </details>

            <a href="/chat" class="use-link">Use this Persona</a>
        </div>
    }
</div>

@code {
    private IReadOnlyList<Persona> personas = Array.Empty<Persona>();

    protected override void OnInitialized()
    {
        personas = PersonaService.GetPersonas();
    }
}